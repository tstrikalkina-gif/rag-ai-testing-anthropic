# Required only for /ask
ANTHROPIC_API_KEY=

# Application model
ANTHROPIC_MODEL=claude-sonnet-5

MAX_OUTPUT_TOKENS=700
TOP_K=4
MIN_RELEVANCE_SCORE=0.35
AUTO_INDEX=true

# Optional cost reporting. Keep 0 unless you set current Anthropic prices yourself.
ANTHROPIC_INPUT_COST_PER_MILLION=0
ANTHROPIC_OUTPUT_COST_PER_MILLION=0